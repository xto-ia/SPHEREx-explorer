{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "context7": {
        "type": "local",
        "command": ["npx", "-y", "@upstash/context7-mcp"],
        "timeout": {
          "startup": 60000
        }
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@0.0.85"],
        "timeout": {
          "startup": 90000
        },
        "environment": {
          "NODE_OPTIONS": "--max-old-space-size=2048"
        }
      }
    }
  }
}